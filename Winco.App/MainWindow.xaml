<Window x:Class="Winco.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Winco.App"
        mc:Ignorable="d"
        Title="Winco" Height="450" Width="800">
    <Grid>
        <DockPanel Margin="12">
            <Button DockPanel.Dock="Top" Content="Atualizar" Click="Refresh_Click" Margin="0,0,0,8"/>
 
            <!-- Linha de estado: diz qual é a janela selecionada e se o estilo foi aplicado -->
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                       Text="Nenhuma janela selecionada."/>
 
            <!-- Os botões de estilo ficam todos aqui. Quando o painel está desativado,
                 todos os botões lá dentro ficam desativados também. -->
            <StackPanel x:Name="StylePanel" DockPanel.Dock="Right" Width="160" Margin="8,0,0,0"
                        IsEnabled="False">
                <Button Content="Modo escuro" Click="Modo_Escuro_Click" Margin="0,0,0,4"/>
                <Button Content="Cantos retos" Click="Cantos_Retos_Click" Margin="0,0,0,4"/>
                <Button Content="Borda vermelha" Click="Borda_Vermelha_Click" Margin="0,0,0,4"/>
                <Button Content="Barra azul" Click="Barra_Azul_Click" Margin="0,0,0,4"/>
                <Button Content="Repor" Click="Repor_Click" Margin="0,12,0,0"/>
            </StackPanel>
 
            <!-- Clicar numa linha seleciona a janela (SelectedItem da ListBox) -->
            <ListBox x:Name="WindowsList" SelectionChanged="WindowsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding ProcessName}" FontWeight="Bold"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding Title}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
 